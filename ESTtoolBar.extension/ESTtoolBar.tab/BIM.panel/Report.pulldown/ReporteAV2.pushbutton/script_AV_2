# ================================================================
# CONFIGURACION
# ================================================================

DENSIDAD_ACERO = 7850.0
DENSIDAD_HORMIGON = 2400.0
FACTOR_CONEXIONES = 0.05

CLASES_NW = [
    (0, 29.9, "Estructura Liviana"),
    (30, 59.9, "Estructura Media"),
    (60, 89.9, "Estructura Pesada"),
    (90, 99999, "Estructura Extrapesada")
]

ORDEN_CLASES = [
    "Estructura Liviana",
    "Estructura Media",
    "Estructura Pesada",
    "Estructura Extrapesada"
]


# ================================================================
# FUNCIONES AUXILIARES
# ================================================================

def m3_a_kg(volumen_m3, densidad):
    return volumen_m3 * densidad


def clasificar_nw(peso_lineal_kg_m):
    for min_nw, max_nw, nombre in CLASES_NW:
        if peso_lineal_kg_m >= min_nw and peso_lineal_kg_m < max_nw:
            return nombre
    return "Sin clasificar"


def convertir_volumen_a_m3(valor_interno):
    try:
        return UnitUtils.ConvertFromInternalUnits(valor_interno, UnitTypeId.CubicMeters)
    except:
        return 0.0


def convertir_longitud_a_m(valor_interno):
    try:
        return UnitUtils.ConvertFromInternalUnits(valor_interno, UnitTypeId.Meters)
    except:
        return 0.0


def obtener_volumen_parametro_m3(elemento):
    try:
        param = elemento.get_Parameter(BuiltInParameter.HOST_VOLUME_COMPUTED)
        if param and param.HasValue:
            valor = param.AsDouble()
            if valor and valor > 0:
                return convertir_volumen_a_m3(valor)
    except:
        pass
    return 0.0


def obtener_volumen_solido_desde_geometria(geo):
    volumen_total = 0.0
    if geo is None:
        return volumen_total
    for obj in geo:
        try:
            if isinstance(obj, Solid):
                if obj.Volume and obj.Volume > 0:
                    volumen_total += obj.Volume
            elif isinstance(obj, GeometryInstance):
                geo_inst = obj.GetInstanceGeometry()
                for inst_obj in geo_inst:
                    try:
                        if isinstance(inst_obj, Solid):
                            if inst_obj.Volume and inst_obj.Volume > 0:
                                volumen_total += inst_obj.Volume
                    except:
                        pass
        except:
            pass
    return volumen_total


def obtener_volumen_geometria_m3(elemento):
    try:
        opt = Options()
        opt.ComputeReferences = False
        opt.IncludeNonVisibleObjects = False
        geo = elemento.get_Geometry(opt)
        volumen_interno = obtener_volumen_solido_desde_geometria(geo)
        if volumen_interno > 0:
            return convertir_volumen_a_m3(volumen_interno)
    except:
        pass
    return 0.0


def obtener_volumen_m3(elemento):
    volumen = obtener_volumen_parametro_m3(elemento)
    if volumen > 0:
        return volumen
    volumen = obtener_volumen_geometria_m3(elemento)
    if volumen > 0:
        return volumen
    return 0.0


def obtener_material_por_parametro(elemento):
    try:
        param = elemento.get_Parameter(BuiltInParameter.STRUCTURAL_MATERIAL_PARAM)
        if param and param.HasValue:
            mat_id = param.AsElementId()
            if mat_id and mat_id != ElementId.InvalidElementId:
                material = elemento.Document.GetElement(mat_id)
                if material:
                    return material.Name.upper()
    except:
        pass
    return ""


def obtener_material_por_material_ids(elemento):
    nombres = []
    try:
        material_ids = elemento.GetMaterialIds(False)
        for mat_id in material_ids:
            material = elemento.Document.GetElement(mat_id)
            if material:
                nombres.append(material.Name.upper())
    except:
        pass
    return " ".join(nombres)


def obtener_nombre_material(elemento):
    nombre = obtener_material_por_parametro(elemento)
    if nombre:
        return nombre
    nombre = obtener_material_por_material_ids(elemento)
    if nombre:
        return nombre
    return ""


def es_acero(nombre_material):
    if not nombre_material:
        return False
    nombre_material = nombre_material.upper()
    keywords = [
        "ACERO", "STEEL", "A36", "A572", "A992", "ER70", "METAL",
        "METALICO", "METALICO", "STRUCTURAL STEEL", "ASTM"
    ]
    for k in keywords:
        if k.upper() in nombre_material:
            return True
    return False


def es_hormigon(nombre_material):
    if not nombre_material:
        return False
    nombre_material = nombre_material.upper()
    keywords = [
        "HORMIGON", "HORMIGON", "CONCRETE", "CONCRETO", "HA",
        "H10", "H20", "H25", "H30", "H35", "H40", "RC",
        "G10", "G20", "G25", "G30", "CAST-IN-PLACE", "CAST IN SITU",
        "PRECAST"
    ]
    for k in keywords:
        if k.upper() in nombre_material:
            return True
    return False


def obtener_largo_m(elemento):
    parametros_largo = [
        BuiltInParameter.STRUCTURAL_FRAME_CUT_LENGTH,
        BuiltInParameter.INSTANCE_LENGTH_PARAM,
        BuiltInParameter.CURVE_ELEM_LENGTH
    ]
    for bip in parametros_largo:
        try:
            param = elemento.get_Parameter(bip)
            if param and param.HasValue:
                valor = param.AsDouble()
                if valor and valor > 0:
                    largo_m = convertir_longitud_a_m(valor)
                    if largo_m > 0:
                        return largo_m
        except:
            pass
    return 1.0


def nombre_categoria(elemento):
    try:
        if elemento.Category:
            return elemento.Category.Name
    except:
        pass
    return "Sin categoria"


def nombre_elemento(elemento):
    try:
        return elemento.Name
    except:
        return "Elemento sin nombre"


def id_elemento_texto(elemento):
    try:
        return str(elemento.Id.IntegerValue)
    except:
        pass
    try:
        return str(elemento.Id.Value)
    except:
        pass
    try:
        return str(elemento.Id)
    except:
        return "Sin Id"


def valor_csv(valor):
    if isinstance(valor, float):
        return ("{:.6f}".format(valor)).replace(".", ",")
    return str(valor)


def escribir_seccion_csv(writer, titulo, columnas, filas):
    writer.writerow([titulo])
    writer.writerow(columnas)
    for fila in filas:
        writer.writerow([valor_csv(v) for v in fila])
    writer.writerow([])


def exportar_reporte_excel_csv(
        doc,
        active_view,
        resumen_general_csv,
        acero_categoria_csv,
        acero_nw_csv,
        hormigon_material_csv,
        hormigon_categoria_csv,
        control_csv,
        detalle_acero,
        detalle_hormigon):
    try:
        dialogo = SaveFileDialog()
        dialogo.Title = "Exportar cubicacion para Excel"
        dialogo.Filter = "Archivo CSV compatible con Excel (*.csv)|*.csv"
        dialogo.FileName = "Cubicacion_Estructural_{}.csv".format(doc.Title)

        if dialogo.ShowDialog() != DialogResult.OK:
            return ""

        ruta = dialogo.FileName

        with open(ruta, "wb") as archivo_csv:
            archivo_csv.write(bytearray([0xEF, 0xBB, 0xBF]))
            writer = csv.writer(archivo_csv, delimiter=';', lineterminator='\n')
            writer.writerow(["REPORTE DE CUBICACION ESTRUCTURAL"])
            writer.writerow(["Proyecto", doc.Title])
            writer.writerow(["Vista activa", active_view.Name])
            writer.writerow([])

            escribir_seccion_csv(
                writer,
                "RESUMEN GENERAL",
                ["Concepto", "Cantidad", "Unidad"],
                resumen_general_csv
            )
            escribir_seccion_csv(
                writer,
                "ACERO POR CATEGORIA",
                ["Categoria", "Cantidad de Elementos", "Peso kg", "Peso ton", "% del Peso"],
                acero_categoria_csv
            )
            escribir_seccion_csv(
                writer,
                "ACERO POR CLASIFICACION NW",
                ["Clase NW", "Cantidad de Elementos", "Peso kg", "Peso ton"],
                acero_nw_csv
            )
            escribir_seccion_csv(
                writer,
                "HORMIGON POR MATERIAL",
                ["Nombre de Material", "Cantidad de Elementos", "Volumen m3"],
                hormigon_material_csv
            )
            escribir_seccion_csv(
                writer,
                "HORMIGON POR CATEGORIA",
                ["Categoria", "Cantidad", "Volumen m3", "Peso kg", "Peso ton", "% del Volumen"],
                hormigon_categoria_csv
            )
            escribir_seccion_csv(
                writer,
                "CONTROL DE REVISION",
                ["Concepto", "Cantidad"],
                control_csv
            )

            detalle_acero_csv = []
            for item in detalle_acero:
                detalle_acero_csv.append([
                    id_elemento_texto(item["elemento"]),
                    item["categoria"],
                    item["nombre"],
                    item["material"],
                    item["clase"],
                    item["volumen_m3"],
                    item["largo_m"],
                    item["peso_lineal"],
                    item["peso_kg"]
                ])
            escribir_seccion_csv(
                writer,
                "DETALLE DE ACERO",
                ["ElementId", "Categoria", "Nombre", "Material", "Clase NW", "Volumen m3", "Largo m", "Peso lineal kg/m", "Peso kg"],
                detalle_acero_csv
            )

            detalle_hormigon_csv = []
            for item in detalle_hormigon:
                detalle_hormigon_csv.append([
                    id_elemento_texto(item["elemento"]),
                    item["categoria"],
                    item["nombre"],
                    item["material"],
                    item["volumen_m3"]
                ])
            escribir_seccion_csv(
                writer,
                "DETALLE DE HORMIGON",
                ["ElementId", "Categoria", "Nombre", "Material", "Volumen m3"],
                detalle_hormigon_csv
            )

        return ruta

    except Exception as ex:
        return "ERROR: {}".format(ex)


# ================================================================
# DOCUMENTO Y RECOLECCION
# ================================================================

doc = revit.doc
active_view = doc.ActiveView

categorias = [
    BuiltInCategory.OST_StructuralFraming,
    BuiltInCategory.OST_StructuralColumns,
    BuiltInCategory.OST_StructuralFoundation
]

elementos = []
for cat in categorias:
    try:
        collector = (
            FilteredElementCollector(doc, active_view.Id)
            .OfCategory(cat)
            .WhereElementIsNotElementType()
        )
        elementos.extend(list(collector))
    except:
        pass


# ================================================================
# PROCESAMIENTO
# ================================================================

resultado_acero = {}
resultado_hormigon = {}
resumen_acero_categoria = {}
total_hormigon_m3 = 0.0

elementos_sin_material = []
elementos_sin_volumen = []
elementos_no_clasificados = []

detalle_acero = []
detalle_hormigon = []

for elem in elementos:
    volumen_m3 = obtener_volumen_m3(elem)

    if volumen_m3 <= 0:
        elementos_sin_volumen.append(elem)
        continue

    nombre_mat = obtener_nombre_material(elem)

    if not nombre_mat:
        elementos_sin_material.append(elem)
        continue

    if es_acero(nombre_mat):
        largo_m = obtener_largo_m(elem)
        peso_total_kg = m3_a_kg(volumen_m3, DENSIDAD_ACERO)

        if largo_m > 0:
            peso_lineal_kg_m = peso_total_kg / largo_m
        else:
            peso_lineal_kg_m = 0.0

        clase_nw = clasificar_nw(peso_lineal_kg_m)
        categoria = nombre_categoria(elem)

        if clase_nw not in resultado_acero:
            resultado_acero[clase_nw] = []
        resultado_acero[clase_nw].append(peso_total_kg)

        if categoria not in resumen_acero_categoria:
            resumen_acero_categoria[categoria] = {
                "cantidad": 0,
                "peso_kg": 0.0
            }
        resumen_acero_categoria[categoria]["cantidad"] += 1
        resumen_acero_categoria[categoria]["peso_kg"] += peso_total_kg

        detalle_acero.append({
            "elemento": elem,
            "categoria": categoria,
            "nombre": nombre_elemento(elem),
            "material": nombre_mat,
            "volumen_m3": volumen_m3,
            "largo_m": largo_m,
            "peso_kg": peso_total_kg,
            "peso_lineal": peso_lineal_kg_m,
            "clase": clase_nw
        })

    elif es_hormigon(nombre_mat):
        total_hormigon_m3 += volumen_m3

        if nombre_mat not in resultado_hormigon:
            resultado_hormigon[nombre_mat] = {
                "cantidad": 0,
                "volumen": 0.0
            }
        resultado_hormigon[nombre_mat]["cantidad"] += 1
        resultado_hormigon[nombre_mat]["volumen"] += volumen_m3

        detalle_hormigon.append({
            "elemento": elem,
            "categoria": nombre_categoria(elem),
            "nombre": nombre_elemento(elem),
            "material": nombre_mat,
            "volumen_m3": volumen_m3
        })

    else:
        elementos_no_clasificados.append(elem)


# ================================================================
# TOTALES Y TABLAS DE DATOS
# ================================================================

total_acero_kg = 0.0
for clase in resultado_acero:
    total_acero_kg += sum(resultado_acero[clase])

peso_conexiones_kg = total_acero_kg * FACTOR_CONEXIONES
total_acero_con_conexiones_kg = total_acero_kg + peso_conexiones_kg
total_hormigon_kg = m3_a_kg(total_hormigon_m3, DENSIDAD_HORMIGON)

# Resumen general
resumen_general_csv = [
    ["Elementos estructurales revisados", len(elementos), "elementos"],
    ["Elementos de acero", len(detalle_acero), "elementos"],
    ["Elementos de hormigon", len(detalle_hormigon), "elementos"],
    ["Acero estructural", total_acero_kg, "kg"],
    ["Factor conexiones", peso_conexiones_kg, "kg"],
    ["Acero total con conexiones", total_acero_con_conexiones_kg, "kg"],
    ["Acero total con conexiones", total_acero_con_conexiones_kg / 1000.0, "ton"],
    ["Hormigon total", total_hormigon_m3, "m3"],
    ["Hormigon total", total_hormigon_kg, "kg"],
    ["Hormigon total", total_hormigon_kg / 1000.0, "ton"]
]

# Acero por categoria
acero_categoria_csv = []
tabla_acero_categoria = []
for categoria in sorted(resumen_acero_categoria.keys()):
    cantidad = resumen_acero_categoria[categoria]["cantidad"]
    peso_kg = resumen_acero_categoria[categoria]["peso_kg"]
    porcentaje = (peso_kg / total_acero_kg * 100.0) if total_acero_kg > 0 else 0.0
    acero_categoria_csv.append([categoria, cantidad, peso_kg, peso_kg / 1000.0, porcentaje])
    tabla_acero_categoria.append([
        categoria,
        str(cantidad),
        "{:,.1f}".format(peso_kg),
        "{:,.2f}".format(peso_kg / 1000.0),
        "{:,.1f}%".format(porcentaje)
    ])
if len(tabla_acero_categoria) > 0:
    tabla_acero_categoria.append([
        "TOTAL",
        str(len(detalle_acero)),
        "{:,.1f}".format(total_acero_kg),
        "{:,.2f}".format(total_acero_kg / 1000.0),
        "100.0%"
    ])

# Acero por NW
acero_nw_csv = []
tabla_acero = []
for clase in ORDEN_CLASES:
    if clase in resultado_acero:
        pesos = resultado_acero[clase]
        total_clase = sum(pesos)
        acero_nw_csv.append([clase, len(pesos), total_clase, total_clase / 1000.0])
        tabla_acero.append([clase, str(len(pesos)), "{:,.1f}".format(total_clase), "{:,.2f}".format(total_clase / 1000.0)])
for clase in resultado_acero:
    if clase not in ORDEN_CLASES:
        pesos = resultado_acero[clase]
        total_clase = sum(pesos)
        acero_nw_csv.append([clase, len(pesos), total_clase, total_clase / 1000.0])
        tabla_acero.append([clase, str(len(pesos)), "{:,.1f}".format(total_clase), "{:,.2f}".format(total_clase / 1000.0)])

# Hormigon por material
hormigon_material_csv = []
tabla_hormigon = []
cantidad_total_hormigon = 0
volumen_total_hormigon = 0.0
for material in sorted(resultado_hormigon.keys()):
    cantidad = resultado_hormigon[material]["cantidad"]
    volumen = resultado_hormigon[material]["volumen"]
    cantidad_total_hormigon += cantidad
    volumen_total_hormigon += volumen
    hormigon_material_csv.append([material, cantidad, volumen])
    tabla_hormigon.append([material, str(cantidad), "{:,.2f}".format(volumen)])
if len(tabla_hormigon) > 0:
    tabla_hormigon.append(["TOTAL", str(cantidad_total_hormigon), "{:,.2f}".format(volumen_total_hormigon)])

# Hormigon por categoria
resumen_hormigon_categoria = {}
for item in detalle_hormigon:
    categoria = item["categoria"] or "Sin categoria"
    if categoria not in resumen_hormigon_categoria:
        resumen_hormigon_categoria[categoria] = {"cantidad": 0, "volumen": 0.0}
    resumen_hormigon_categoria[categoria]["cantidad"] += 1
    resumen_hormigon_categoria[categoria]["volumen"] += item["volumen_m3"]

hormigon_categoria_csv = []
tabla_resumen_hormigon = []
for categoria in sorted(resumen_hormigon_categoria.keys()):
    cantidad = resumen_hormigon_categoria[categoria]["cantidad"]
    volumen = resumen_hormigon_categoria[categoria]["volumen"]
    peso_kg = m3_a_kg(volumen, DENSIDAD_HORMIGON)
    porcentaje = (volumen / total_hormigon_m3 * 100.0) if total_hormigon_m3 > 0 else 0.0
    hormigon_categoria_csv.append([categoria, cantidad, volumen, peso_kg, peso_kg / 1000.0, porcentaje])
    tabla_resumen_hormigon.append([
        categoria,
        str(cantidad),
        "{:,.2f}".format(volumen),
        "{:,.1f}".format(peso_kg),
        "{:,.2f}".format(peso_kg / 1000.0),
        "{:,.1f}%".format(porcentaje)
    ])
if len(tabla_resumen_hormigon) > 0:
    tabla_resumen_hormigon.append([
        "TOTAL",
        str(len(detalle_hormigon)),
        "{:,.2f}".format(total_hormigon_m3),
        "{:,.1f}".format(total_hormigon_kg),
        "{:,.2f}".format(total_hormigon_kg / 1000.0),
        "100.0%"
    ])

control_csv = [
    ["Elementos revisados", len(elementos)],
    ["Acero detectado", len(detalle_acero)],
    ["Hormigon detectado", len(detalle_hormigon)],
    ["Sin volumen valido", len(elementos_sin_volumen)],
    ["Sin material detectable", len(elementos_sin_material)],
    ["Material no clasificado", len(elementos_no_clasificados)]
]


# ================================================================
# REPORTE PYREVIT
# ================================================================

output = script.get_output()
output.close_others()
output.set_title("Cubicacion Estructural - {}".format(doc.Title))

output.print_md("# Reporte de Cubicacion Estructural")
output.print_md("**Proyecto:** {}".format(doc.Title))
output.print_md("**Vista activa:** {}".format(active_view.Name))

output.print_md("---")
output.print_md("## Resumen General")
tabla_resumen_general = []
for concepto, cantidad, unidad in resumen_general_csv:
    if isinstance(cantidad, float):
        valor = "{:,.2f}".format(cantidad)
    else:
        valor = str(cantidad)
    tabla_resumen_general.append([concepto, valor, unidad])
output.print_table(
    table_data=tabla_resumen_general,
    title="Resumen General de la Cubicacion",
    columns=["Concepto", "Cantidad", "Unidad"]
)

output.print_md("---")
output.print_md("## Acero por Categoria")
if len(tabla_acero_categoria) > 0:
    output.print_table(
        table_data=tabla_acero_categoria,
        title="Resumen de Acero por Categoria",
        columns=["Categoria", "Cantidad", "Peso kg", "Peso ton", "% del Peso"]
    )
else:
    output.print_md("**No se encontraron elementos de acero estructural reconocibles.**")

output.print_md("---")
output.print_md("## Acero por Clasificacion NW")
if len(tabla_acero) > 0:
    output.print_table(
        table_data=tabla_acero,
        title="Clasificacion por Nominal Weight",
        columns=["Clase NW", "N Elementos", "Peso kg", "Peso ton"]
    )
else:
    output.print_md("**No se encontraron elementos de acero estructural con material reconocible.**")
output.print_md("**Subtotal acero:** {:,.1f} kg ({:,.2f} ton)".format(total_acero_kg, total_acero_kg / 1000.0))
output.print_md("**Factor conexiones ({:.0f}%):** + {:,.1f} kg".format(FACTOR_CONEXIONES * 100.0, peso_conexiones_kg))
output.print_md("### Total acero con conexiones: {:,.1f} kg ({:,.2f} ton)".format(total_acero_con_conexiones_kg, total_acero_con_conexiones_kg / 1000.0))

output.print_md("---")
output.print_md("## Hormigon por Material")
if len(tabla_hormigon) > 0:
    output.print_table(
        table_data=tabla_hormigon,
        title="Desglose por Material de Hormigon",
        columns=["Nombre de Material", "Cantidad de Elementos", "Volumen (m3)"]
    )
else:
    output.print_md("**No se encontraron elementos de hormigon estructural reconocibles.**")

output.print_md("---")
output.print_md("## Hormigon por Categoria")
if len(tabla_resumen_hormigon) > 0:
    output.print_table(
        table_data=tabla_resumen_hormigon,
        title="Resumen de Hormigon por Categoria",
        columns=["Categoria", "Cantidad", "Volumen (m3)", "Peso (kg)", "Peso (ton)", "% del Volumen"]
    )
output.print_md("**Volumen total:** {:,.2f} m3".format(total_hormigon_m3))
output.print_md("**Peso total:** {:,.1f} kg ({:,.2f} ton)".format(total_hormigon_kg, total_hormigon_kg / 1000.0))

output.print_md("---")
output.print_md("## Control de Revision")
tabla_control = [[str(x[0]), str(x[1])] for x in control_csv]
output.print_table(
    table_data=tabla_control,
    title="Resumen de Control",
    columns=["Concepto", "Cantidad"]
)

# Listados de control
if len(elementos_no_clasificados) > 0:
    tabla = []
    for elem in elementos_no_clasificados[:50]:
        tabla.append([id_elemento_texto(elem), nombre_categoria(elem), nombre_elemento(elem), obtener_nombre_material(elem)])
