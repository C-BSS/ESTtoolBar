resultado_hormigon = {}
acero_categoria_datos = {}
matriz_nw_datos = {}
detalle_acero = []
detalle_hormigon = []
sin_volumen = []
sin_material = []
no_clasificados = []
sin_parametros_peso = []
sin_longitud = []
detalle_barandas = []
pernos_por_tipo = {}
grout_columnas = []
total_hormigon_m3 = 0.0

