def limpiar_nombre_hoja(nombre):
    nombre_limpio = str(nombre)
    for caracter in ["[", "]", ":", "*", "?", "/", "\\"]:
        nombre_limpio = nombre_limpio.replace(caracter, "-")
    if len(nombre_limpio) > 31:
        nombre_limpio = nombre_limpio[:31]
    return nombre_limpio


def escribir_hoja_excel(hoja, titulo, columnas, filas):
    hoja.Name = limpiar_nombre_hoja(titulo)

    total_columnas = len(columnas)
    total_filas = len(filas) + 2

    hoja.Cells[1, 1] = titulo
    hoja.Range[hoja.Cells[1, 1], hoja.Cells[1, total_columnas]].Merge()
    hoja.Range[hoja.Cells[1, 1], hoja.Cells[1, total_columnas]].Font.Bold = True
    hoja.Range[hoja.Cells[1, 1], hoja.Cells[1, total_columnas]].Font.Color = 16777215
    hoja.Range[hoja.Cells[1, 1], hoja.Cells[1, total_columnas]].Interior.Color = 8210719

    for indice_columna in range(len(columnas)):
        hoja.Cells[2, indice_columna + 1] = columnas[indice_columna]

    rango_encabezado = hoja.Range[hoja.Cells[2, 1], hoja.Cells[2, total_columnas]]
    rango_encabezado.Font.Bold = True
    rango_encabezado.Font.Color = 16777215
    rango_encabezado.Interior.Color = 3960653

    for indice_fila in range(len(filas)):
        fila = filas[indice_fila]
        for indice_columna in range(len(fila)):
            hoja.Cells[indice_fila + 3, indice_columna + 1] = fila[indice_columna]

    if len(filas) > 0:
        rango_datos = hoja.Range[hoja.Cells[3, 1], hoja.Cells[total_filas, total_columnas]]
        rango_datos.Borders.LineStyle = 1

        ultima_fila = filas[-1]
        if len(ultima_fila) > 0 and str(ultima_fila[0]).upper() == "TOTAL":
            rango_total = hoja.Range[hoja.Cells[total_filas, 1], hoja.Cells[total_filas, total_columnas]]
            rango_total.Font.Bold = True
            rango_total.Interior.Color = 14277081

    hoja.Columns.AutoFit()
    hoja.Rows[1].RowHeight = 24

    try:
        hoja.Application.ActiveWindow.SplitRow = 2
        hoja.Application.ActiveWindow.FreezePanes = True
    except:
        pass


def exportar_reporte_xlsx(
        doc,
        active_view,
        resumen_general_xlsx,
        acero_categoria_xlsx,
        acero_nw_xlsx,
        matriz_nw_xlsx,
        hormigon_material_xlsx,
        hormigon_categoria_xlsx,
        control_xlsx,
        detalle_acero,
        detalle_hormigon):

    excel = None
    libro = None

    try:
        clr.AddReferenceByName('Microsoft.Office.Interop.Excel')
        import Microsoft.Office.Interop.Excel as Excel

        dialogo = SaveFileDialog()
        dialogo.Title = "Exportar cubicacion a Excel"
        dialogo.Filter = "Libro de Excel (*.xlsx)|*.xlsx"
        dialogo.FileName = "Cubicacion_Estructural_{}.xlsx".format(doc.Title)

        if dialogo.ShowDialog() != DialogResult.OK:
            return ""

        ruta = dialogo.FileName
        if not ruta.lower().endswith(".xlsx"):
            ruta += ".xlsx"

        excel = Excel.ApplicationClass()
        excel.Visible = False
        excel.DisplayAlerts = False

        libro = excel.Workbooks.Add()

        hojas_requeridas = 9
        while libro.Worksheets.Count < hojas_requeridas:
            libro.Worksheets.Add()

        detalle_acero_xlsx = []
        for item in detalle_acero:
            detalle_acero_xlsx.append([
                id_elemento_texto(item["elemento"]),
                item["categoria"],
                item["categoria_clave"],
                item["nombre"],
                item["material"],
                item["clase"],
                item["volumen_m3"],
                item["largo_m"],
                item["peso_lineal"],
                item["peso_kg"]
            ])

        detalle_hormigon_xlsx = []
        for item in detalle_hormigon:
            detalle_hormigon_xlsx.append([
                id_elemento_texto(item["elemento"]),
                item["categoria"],
                item["nombre"],
                item["material"],
                item["volumen_m3"]
            ])

        hojas = [
            ("Resumen General", ["Concepto", "Cantidad", "Unidad"], resumen_general_xlsx),
            ("Acero Categoria", ["Categoria", "Cantidad", "Peso kg", "Peso ton", "% del Peso"], acero_categoria_xlsx),
            ("Acero NW", ["Clase NW", "Cantidad", "Peso kg", "Peso ton"], acero_nw_xlsx),
            ("Matriz NW Categoria", ["Clase NW", "Columns", "Framing", "Foundations", "Other", "Total"], matriz_nw_xlsx),
            ("Hormigon Material", ["Material", "Cantidad", "Volumen m3"], hormigon_material_xlsx),
            ("Hormigon Categoria", ["Categoria", "Cantidad", "Volumen m3", "Peso kg", "Peso ton", "% Volumen"], hormigon_categoria_xlsx),
            ("Control", ["Concepto", "Cantidad"], control_xlsx),
            ("Detalle Acero", ["ElementId", "Categoria Revit", "Categoria Resumen", "Nombre", "Material", "Clase NW", "Volumen m3", "Largo m", "Peso lineal kg/m", "Peso kg"], detalle_acero_xlsx),
            ("Detalle Hormigon", ["ElementId", "Categoria", "Nombre", "Material", "Volumen m3"], detalle_hormigon_xlsx)
        ]

        for indice in range(len(hojas)):
            hoja = libro.Worksheets[indice + 1]
            titulo, columnas, filas = hojas[indice]
            escribir_hoja_excel(hoja, titulo, columnas, filas)

        libro.SaveAs(ruta, 51)
        libro.Close(True)
        excel.Quit()

        return ruta

    except Exception as ex:
        try:
            if libro is not None:
                libro.Close(False)
        except:
            pass

        try:
            if excel is not None:
                excel.Quit()
        except:
            pass

        return "ERROR: {}".format(ex)

    finally:
        try:
            if libro is not None:
                Marshal.FinalReleaseComObject(libro)
        except:
            pass

        try:
            if excel is not None:
                Marshal.FinalReleaseComObject(excel)
        except:
            pass


# ================================================================
# DOCUMENTO Y RECOLECCION
# ================================================================

doc = revit.doc
active_view = doc.ActiveView

categorias = [
    BuiltInCategory.OST_StructuralFraming,
    BuiltInCategory.OST_StructuralColumns,
    BuiltInCategory.OST_StructuralFoundation
]

elementos = []

for cat in categorias:
    try:
        collector = (
            FilteredElementCollector(doc, active_view.Id)
            .OfCategory(cat)
            .WhereElementIsNotElementType()
        )
        elementos.extend(list(collector))
    except:
        pass


# ================================================================
# PROCESAMIENTO
# ================================================================

resultado_acero = {}
resultado_hormigon = {}
resumen_acero_categoria = {}
matriz_nw_categoria = {}
total_hormigon_m3 = 0.0

elementos_sin_material = []
elementos_sin_volumen = []
elementos_no_clasificados = []

detalle_acero = []
detalle_hormigon = []

for elem in elementos:
    volumen_m3 = obtener_volumen_m3(elem)

    if volumen_m3 <= 0:
        elementos_sin_volumen.append(elem)
        continue

    nombre_mat = obtener_nombre_material(elem)

    if not nombre_mat:
        elementos_sin_material.append(elem)
        continue

    if es_acero(nombre_mat):
        largo_m = obtener_largo_m(elem)
        peso_total_kg = m3_a_kg(volumen_m3, DENSIDAD_ACERO)

        if largo_m > 0:
            peso_lineal_kg_m = peso_total_kg / largo_m
        else:
            peso_lineal_kg_m = 0.0

        clase_nw = clasificar_nw(peso_lineal_kg_m)
        categoria = nombre_categoria(elem)
        categoria_clave = categoria_acero_clave(elem)

        if clase_nw not in resultado_acero:
            resultado_acero[clase_nw] = []
        resultado_acero[clase_nw].append(peso_total_kg)

        if categoria_clave not in resumen_acero_categoria:
            resumen_acero_categoria[categoria_clave] = {
                "cantidad": 0,
                "peso_kg": 0.0
            }
        resumen_acero_categoria[categoria_clave]["cantidad"] += 1
        resumen_acero_categoria[categoria_clave]["peso_kg"] += peso_total_kg

        if clase_nw not in matriz_nw_categoria:
            matriz_nw_categoria[clase_nw] = {
                "Columns": 0,
                "Framing": 0,
                "Foundations": 0,
                "Other": 0
            }
        matriz_nw_categoria[clase_nw][categoria_clave] += 1

        detalle_acero.append({
            "elemento": elem,
            "categoria": categoria,
            "categoria_clave": categoria_clave,
            "nombre": nombre_elemento(elem),
            "material": nombre_mat,
            "volumen_m3": volumen_m3,
            "largo_m": largo_m,
            "peso_kg": peso_total_kg,
            "peso_lineal": peso_lineal_kg_m,
            "clase": clase_nw
        })

    elif es_hormigon(nombre_mat):
        total_hormigon_m3 += volumen_m3

        if nombre_mat not in resultado_hormigon:
            resultado_hormigon[nombre_mat] = {
                "cantidad": 0,
                "volumen": 0.0
            }

        resultado_hormigon[nombre_mat]["cantidad"] += 1
        resultado_hormigon[nombre_mat]["volumen"] += volumen_m3

        detalle_hormigon.append({
            "elemento": elem,
            "categoria": nombre_categoria(elem),
            "nombre": nombre_elemento(elem),
            "material": nombre_mat,
            "volumen_m3": volumen_m3
        })

    else:
        elementos_no_clasificados.append(elem)


# ================================================================
# TOTALES Y TABLAS
# ================================================================

total_acero_kg = 0.0
for clase in resultado_acero:
    total_acero_kg += sum(resultado_acero[clase])

peso_conexiones_kg = total_acero_kg * FACTOR_CONEXIONES
total_acero_con_conexiones_kg = total_acero_kg + peso_conexiones_kg
total_hormigon_kg = m3_a_kg(total_hormigon_m3, DENSIDAD_HORMIGON)

resumen_general_xlsx = [
    ["Elementos estructurales revisados", len(elementos), "elementos"],
    ["Elementos de acero", len(detalle_acero), "elementos"],
    ["Elementos de hormigon", len(detalle_hormigon), "elementos"],
    ["Acero estructural", total_acero_kg, "kg"],
    ["Factor conexiones", peso_conexiones_kg, "kg"],
    ["Acero total con conexiones", total_acero_con_conexiones_kg, "kg"],
    ["Acero total con conexiones", total_acero_con_conexiones_kg / 1000.0, "ton"],
    ["Hormigon total", total_hormigon_m3, "m3"],
    ["Hormigon total", total_hormigon_kg, "kg"],
    ["Hormigon total", total_hormigon_kg / 1000.0, "ton"]
]

# Acero por categoria
acero_categoria_xlsx = []
tabla_acero_categoria = []

for categoria in ORDEN_CATEGORIAS_ACERO:
    if categoria in resumen_acero_categoria:
        cantidad = resumen_acero_categoria[categoria]["cantidad"]
        peso_kg = resumen_acero_categoria[categoria]["peso_kg"]
        porcentaje = (peso_kg / total_acero_kg * 100.0) if total_acero_kg > 0 else 0.0

        acero_categoria_xlsx.append([
            categoria,
            cantidad,
            peso_kg,
            peso_kg / 1000.0,
            porcentaje / 100.0
        ])

        tabla_acero_categoria.append([
            categoria,
            str(cantidad),
            "{:,.1f}".format(peso_kg),
            "{:,.2f}".format(peso_kg / 1000.0),
            "{:,.1f}%".format(porcentaje)
        ])

if len(tabla_acero_categoria) > 0:
    acero_categoria_xlsx.append([
        "TOTAL",
        len(detalle_acero),
        total_acero_kg,
        total_acero_kg / 1000.0,
        1.0
    ])

    tabla_acero_categoria.append([
        "TOTAL",
        str(len(detalle_acero)),
        "{:,.1f}".format(total_acero_kg),
        "{:,.2f}".format(total_acero_kg / 1000.0),
        "100.0%"
    ])

# Acero por NW
acero_nw_xlsx = []
tabla_acero = []

for clase in ORDEN_CLASES:
    if clase in resultado_acero:
        pesos = resultado_acero[clase]
        total_clase = sum(pesos)

        acero_nw_xlsx.append([
            clase,
            len(pesos),
            total_clase,
            total_clase / 1000.0
        ])

        tabla_acero.append([
            clase,
            str(len(pesos)),
            "{:,.1f}".format(total_clase),
            "{:,.2f}".format(total_clase / 1000.0)
        ])

for clase in resultado_acero:
    if clase not in ORDEN_CLASES:
        pesos = resultado_acero[clase]
        total_clase = sum(pesos)

        acero_nw_xlsx.append([
            clase,
            len(pesos),
            total_clase,
            total_clase / 1000.0
        ])

        tabla_acero.append([
            clase,
            str(len(pesos)),
            "{:,.1f}".format(total_clase),
            "{:,.2f}".format(total_clase / 1000.0)
        ])

# Matriz NW por categoria
matriz_nw_xlsx = []
tabla_matriz_nw = []
total_columns = 0
total_framing = 0
total_foundations = 0
total_other = 0

clases_matriz = list(ORDEN_CLASES)
for clase in matriz_nw_categoria:
    if clase not in clases_matriz:
        clases_matriz.append(clase)

for clase in clases_matriz:
    datos = matriz_nw_categoria.get(clase, {
        "Columns": 0,
        "Framing": 0,
        "Foundations": 0,
        "Other": 0
    })

    columns = datos["Columns"]
    framing = datos["Framing"]
    foundations = datos["Foundations"]
    other = datos["Other"]
    total_fila = columns + framing + foundations + other

    total_columns += columns
    total_framing += framing
    total_foundations += foundations
    total_other += other

    matriz_nw_xlsx.append([
        clase,
        columns,
        framing,
        foundations,
        other,
        total_fila
    ])

    tabla_matriz_nw.append([
        clase,
        str(columns),
        str(framing),
        str(foundations),
        str(other),
        str(total_fila)
    ])

matriz_nw_xlsx.append([
    "TOTAL",
    total_columns,
    total_framing,
    total_foundations,
    total_other,
    total_columns + total_framing + total_foundations + total_other
])

tabla_matriz_nw.append([
    "TOTAL",
    str(total_columns),
    str(total_framing),
    str(total_foundations),
    str(total_other),
    str(total_columns + total_framing + total_foundations + total_other)
])

# Hormigon por material
hormigon_material_xlsx = []
tabla_hormigon = []
cantidad_total_hormigon = 0
volumen_total_hormigon = 0.0

for material in sorted(resultado_hormigon.keys()):
    cantidad = resultado_hormigon[material]["cantidad"]
    volumen = resultado_hormigon[material]["volumen"]

    cantidad_total_hormigon += cantidad
    volumen_total_hormigon += volumen

    hormigon_material_xlsx.append([
        material,
        cantidad,
        volumen
    ])

    tabla_hormigon.append([
        material,
        str(cantidad),
        "{:,.2f}".format(volumen)
    ])

if len(tabla_hormigon) > 0:
    hormigon_material_xlsx.append([
        "TOTAL",
        cantidad_total_hormigon,
        volumen_total_hormigon
    ])

    tabla_hormigon.append([
        "TOTAL",
        str(cantidad_total_hormigon),
        "{:,.2f}".format(volumen_total_hormigon)
