DENSIDAD_ACERO = 7850.0
DENSIDAD_HORMIGON = 2400.0
FACTOR_CONEXIONES = 0.05

CLASES_NW = [
    (0, 29.9, "Estructura Liviana"),
    (30, 59.9, "Estructura Media"),
    (60, 89.9, "Estructura Pesada"),
    (90, 99999, "Estructura Extrapesada")
]

ORDEN_CLASES = [
    "Estructura Liviana",
    "Estructura Media",
    "Estructura Pesada",
