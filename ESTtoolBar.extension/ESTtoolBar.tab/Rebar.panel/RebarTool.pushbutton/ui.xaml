<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RebarTool Pro v3.1" Width="1220" Height="840" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="13" Background="#0F1117">
  <Window.Resources>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#242938"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#3B4258"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Background" Value="#F9FAFB"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,4,0,8"/>
      <Setter Property="IsTextSearchEnabled" Value="True"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Margin" Value="0,5,0,5"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="#1A1D27"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#333750"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#38BDF8"/>
      <Setter Property="Foreground" Value="#0F1117"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#2D3145"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="#1A1D27"/>
      <Setter Property="BorderBrush" Value="#333750"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#1A1D27" Padding="22,14" BorderBrush="#333750" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="RebarTool Pro v3.1" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Interfaz WPFWindow estable + vista previa gráfica tipo Naviate" Foreground="#D1D5DB"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D1D5DB" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusTxt" Text="Sin elemento" Foreground="#D1D5DB"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="410"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#151923" BorderBrush="#333750" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
          <TextBlock Text="MODULOS" Foreground="#D1D5DB" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
          <Button x:Name="BtnFoundation" Style="{StaticResource NavButton}" Content="Fundaciones" Click="on_foundation_click"/>
          <Button x:Name="BtnColumn" Style="{StaticResource NavButton}" Content="Columnas" Click="on_column_click"/>
          <Button x:Name="BtnBeam" Style="{StaticResource NavButton}" Content="Vigas" Click="on_beam_click"/>
          <Button x:Name="BtnWall" Style="{StaticResource NavButton}" Content="Muros" Click="on_wall_click"/>
          <Button x:Name="BtnPile" Style="{StaticResource NavButton}" Content="Pilas" Click="on_pile_click"/>
          <Separator Margin="0,12,0,12"/>
          <TextBlock Text="Plantillas" Foreground="#D1D5DB" FontWeight="Bold"/>
          <ComboBox x:Name="TemplateCombo" Style="{StaticResource Combo}"/>
          <Button x:Name="BtnSaveTemplate" Style="{StaticResource NavButton}" Content="Guardar plantilla" Click="on_template_stub_click"/>
          <Button x:Name="BtnLoadTemplate" Style="{StaticResource NavButton}" Content="Cargar plantilla" Click="on_template_stub_click"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="16,0" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="ViewStart">
            <TextBlock Text="Selecciona un módulo" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="La v3.1 usa pyrevit.forms.WPFWindow con XAML separado para evitar los problemas de eventos detectados con XamlReader.Load." Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="ViewFoundation" Visibility="Collapsed">
            <TextBlock Text="Fundaciones" Foreground="#FB923C" FontSize="22" FontWeight="Bold"/>
            <ComboBox x:Name="FndSubtype" Style="{StaticResource Combo}"/>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Geometría y selección" Foreground="#FFFFFF" FontWeight="Bold"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBox x:Name="FndTxbElem" Style="{StaticResource Field}" Text="Seleccionar fundación" IsReadOnly="True"/>
                <Button Grid.Column="1" x:Name="FndBtnSel" Content="Seleccionar" Style="{StaticResource PrimaryButton}" Click="on_select_element_click"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="FndTxbX" Style="{StaticResource Field}" Text="-" IsReadOnly="True"/>
                <TextBox x:Name="FndTxbY" Grid.Column="1" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="FndTxbZ" Grid.Column="2" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="FndTxbCover" Grid.Column="3" Style="{StaticResource Field}" Text="75" Margin="6,4,0,8" TextChanged="on_preview_changed"/>
              </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Malla inferior" Foreground="#FFFFFF" FontWeight="Bold"/>
              <CheckBox x:Name="FndChkBotX" Content="Dirección X" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="FndCmbBotX" Style="{StaticResource Combo}"/>
              <TextBox x:Name="FndTxbBotXSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="FndChkBotY" Content="Dirección Y" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="FndCmbBotY" Style="{StaticResource Combo}"/>
              <TextBox x:Name="FndTxbBotYSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Malla superior, pedestal y esperas" Foreground="#FFFFFF" FontWeight="Bold"/>
              <CheckBox x:Name="FndChkTop" Content="Activar malla superior" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <CheckBox x:Name="FndChkTopX" Content="Superior X" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="FndCmbTopX" Style="{StaticResource Combo}"/>
              <TextBox x:Name="FndTxbTopXSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="FndChkTopY" Content="Superior Y" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="FndCmbTopY" Style="{StaticResource Combo}"/>
              <TextBox x:Name="FndTxbTopYSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="FndChkPedestal" Content="Fundación con pedestal" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <CheckBox x:Name="FndChkDowels" Content="Generar esperas" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="ViewColumn" Visibility="Collapsed">
            <TextBlock Text="Columnas" Foreground="#38BDF8" FontSize="22" FontWeight="Bold"/>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Geometría y selección" Foreground="#FFFFFF" FontWeight="Bold"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ColTxbElem" Style="{StaticResource Field}" Text="Seleccionar columna" IsReadOnly="True"/>
                <Button Grid.Column="1" x:Name="ColBtnSel" Content="Seleccionar" Style="{StaticResource PrimaryButton}" Click="on_select_element_click"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="ColTxbX" Style="{StaticResource Field}" Text="-" IsReadOnly="True"/>
                <TextBox x:Name="ColTxbY" Grid.Column="1" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="ColTxbZ" Grid.Column="2" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="ColTxbCover" Grid.Column="3" Style="{StaticResource Field}" Text="30" Margin="6,4,0,8" TextChanged="on_preview_changed"/>
              </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Barras longitudinales" Foreground="#FFFFFF" FontWeight="Bold"/>
              <CheckBox x:Name="ColChkLong" Content="Activar" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="ColCmbLong" Style="{StaticResource Combo}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="ColTxbLongNX" Style="{StaticResource Field}" Text="3" TextChanged="on_preview_changed"/>
                <TextBox x:Name="ColTxbLongNY" Grid.Column="1" Style="{StaticResource Field}" Text="3" Margin="6,4,0,8" TextChanged="on_preview_changed"/>
              </Grid>
              <TextBlock x:Name="ColLblLongInfo" Text="Total estimado: 8 barras perimetrales" Foreground="#38BDF8" Margin="0,4,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Estribos y confinamiento" Foreground="#FFFFFF" FontWeight="Bold"/>
              <CheckBox x:Name="ColChkStir" Content="Activar estribos" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="ColCmbStir" Style="{StaticResource Combo}"/>
              <ComboBox x:Name="ColCmbHook" Style="{StaticResource Combo}"/>
              <TextBox x:Name="ColTxbStirSp" Style="{StaticResource Field}" Text="150" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="ColChkZone" Content="Zona confinada" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <TextBox x:Name="ColTxbZoneSp" Style="{StaticResource Field}" Text="75" TextChanged="on_preview_changed"/>
              <TextBox x:Name="ColTxbZoneLen" Style="{StaticResource Field}" Text="500" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="ColChkDowels" Content="Dowels / empalmes" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="ViewBeam" Visibility="Collapsed">
            <TextBlock Text="Vigas" Foreground="#A78BFA" FontSize="22" FontWeight="Bold"/>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Geometría y selección" Foreground="#FFFFFF" FontWeight="Bold"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBox x:Name="BmTxbElem" Style="{StaticResource Field}" Text="Seleccionar viga" IsReadOnly="True"/>
                <Button Grid.Column="1" x:Name="BmBtnSel" Content="Seleccionar" Style="{StaticResource PrimaryButton}" Click="on_select_element_click"/>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBox x:Name="BmTxbX" Style="{StaticResource Field}" Text="-" IsReadOnly="True"/>
                <TextBox x:Name="BmTxbY" Grid.Column="1" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="BmTxbZ" Grid.Column="2" Style="{StaticResource Field}" Text="-" IsReadOnly="True" Margin="6,4,0,8"/>
                <TextBox x:Name="BmTxbCover" Grid.Column="3" Style="{StaticResource Field}" Text="25" Margin="6,4,0,8" TextChanged="on_preview_changed"/>
              </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Barras y estribos" Foreground="#FFFFFF" FontWeight="Bold"/>
              <CheckBox x:Name="BmChkBot" Content="Armadura inferior" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="BmCmbBot" Style="{StaticResource Combo}"/>
              <TextBox x:Name="BmTxbBotN" Style="{StaticResource Field}" Text="3" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="BmChkTop" Content="Armadura superior" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <ComboBox x:Name="BmCmbTop" Style="{StaticResource Combo}"/>
              <TextBox x:Name="BmTxbTopN" Style="{StaticResource Field}" Text="2" TextChanged="on_preview_changed"/>
              <CheckBox x:Name="BmChkSkin" Content="Barras de piel" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
              <CheckBox x:Name="BmChkStir" Content="Estribos" IsChecked="True" Checked="on_preview_changed" Unchecked="on_preview_changed"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="ViewWall" Visibility="Collapsed">
            <TextBlock Text="Muros" Foreground="#34D399" FontSize="22" FontWeight="Bold"/>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Módulo preparado" Foreground="#FFFFFF" FontWeight="Bold"/>
              <TextBlock Text="Verticales, horizontales, dos caras, bordes, dowels y aberturas. Motor pendiente." Foreground="#D1D5DB" TextWrapping="Wrap"/>
              <ComboBox x:Name="WallCmbVert" Style="{StaticResource Combo}"/>
              <TextBox x:Name="WallTxbVertSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
              <ComboBox x:Name="WallCmbHor" Style="{StaticResource Combo}"/>
              <TextBox x:Name="WallTxbHorSp" Style="{StaticResource Field}" Text="200" TextChanged="on_preview_changed"/>
            </StackPanel></Border>
          </StackPanel>

          <StackPanel x:Name="ViewPile" Visibility="Collapsed">
            <TextBlock Text="Pilas" Foreground="#FACC15" FontSize="22" FontWeight="Bold"/>
            <Border Style="{StaticResource Section}"><StackPanel>
              <TextBlock Text="Módulo preparado" Foreground="#FFFFFF" FontWeight="Bold"/>
              <TextBlock Text="Barras principales, estribo circular, espiral y anclajes. Motor pendiente." Foreground="#D1D5DB" TextWrapping="Wrap"/>
              <ComboBox x:Name="PileCmbMain" Style="{StaticResource Combo}"/>
              <TextBox x:Name="PileTxbMainN" Style="{StaticResource Field}" Text="12" TextChanged="on_preview_changed"/>
              <ComboBox x:Name="PileCmbStir" Style="{StaticResource Combo}"/>
              <TextBox x:Name="PileTxbStirSp" Style="{StaticResource Field}" Text="150" TextChanged="on_preview_changed"/>
            </StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Column="2" Background="#151923" BorderBrush="#333750" BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="Vista previa" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
          <TextBlock x:Name="PreviewTitle" Text="Sin módulo" Foreground="#D1D5DB" Margin="0,4,0,12"/>
          <Border Background="#0F1117" BorderBrush="#2D3145" BorderThickness="1" Padding="8" CornerRadius="8">
            <Canvas x:Name="PreviewCanvas" Width="350" Height="430" Background="#0F1117"/>
          </Border>
          <TextBlock x:Name="PreviewInfo" Text="Vista previa gráfica. No crea armaduras." Foreground="#E5E7EB" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#1A1D27" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterMsg" Text="Selecciona un módulo para comenzar." Foreground="#D1D5DB" VerticalAlignment="Center"/>
        <Button x:Name="BtnDiagnostic" Grid.Column="1" Content="Diagnóstico" Style="{StaticResource GhostButton}" Click="on_diagnostic_click"/>
        <Button x:Name="BtnApply" Grid.Column="2" Content="Aplicar armaduras" Style="{StaticResource PrimaryButton}" Click="on_apply_click"/>
        <Button x:Name="BtnClose" Grid.Column="3" Content="Cerrar" Style="{StaticResource GhostButton}" Click="on_close_click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
